# Copy to .env and fill in. .env is gitignored — never commit real credentials.

# --- server ---
NETDOG_LISTEN=0.0.0.0:8688
# Shared secret; agents must send ?token=... matching this. Use a long random string.
NETDOG_TOKEN=change-me-to-a-long-random-string
# Seconds without a heartbeat before a device is declared offline.
NETDOG_OFFLINE_TIMEOUT=90

# --- web panel login ---
# The dashboard at / and /api/status require login with these credentials.
PANEL_USER=admin
# If left empty, a random password is generated on startup and printed to the log.
PANEL_PASSWORD=change-me

# --- email alerts ---
NETDOG_EMAIL_ENABLED=true
# Comma-separated recipients.
NETDOG_EMAIL_TO=ops@example.com
SMTP_HOST=mail.example.com
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_USERNAME=ops@example.com
SMTP_PASSWORD=change-me
SMTP_FROM=ops@example.com
SMTP_DISPLAY_NAME=Netdog Alerts
